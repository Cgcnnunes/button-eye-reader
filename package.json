{
  "name": "button-eye-reader",
  "version": "0.4.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.22.2"
  },
  "scripts": {
    "branch:new": "node scripts/repository.ts branch",
    "build": "npm run check && vite build",
    "check": "tsc --noEmit",
    "commit:next": "node scripts/repository.ts next",
    "commitlint": "commitlint",
    "deploy": "npm run verify && wrangler deploy --env test",
    "dev": "vite --host 127.0.0.1",
    "docs:check": "node scripts/repository.ts staged",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix --max-warnings 0",
    "precommit": "npm run docs:check && lint-staged && npm run check && npm test",
    "prepare": "husky",
    "preview": "vite preview --host 127.0.0.1",
    "repo:check": "node scripts/repository.ts pr",
    "release:prepare": "node scripts/repository.ts version",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "verify": "npm run format:check && npm run lint && npm test && npm run build"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/types": "^21.2.3",
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/node": "^22.15.30",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-perfectionist": "^5.13.0",
    "globals": "^17.4.0",
    "husky": "^9.1.7",
    "jsdom": "^31.0.0",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.6",
    "vitest": "^5.1.0",
    "wrangler": "^4.158.0"
  },
  "overrides": {
    "minimatch": "^11.0.1"
  },
  "lint-staged": {
    "*.{js,mjs,ts}": [
      "eslint --fix --max-warnings 0",
      "prettier --write"
    ],
    "*.{css,html,json,jsonc,md,yml,yaml}": "prettier --write"
  }
}
