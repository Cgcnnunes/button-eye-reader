{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "button-eye-reader",
  "compatibility_date": "2026-11-07",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
  },
  "observability": { "enabled": false },
  "env": {
    "production": {
      "name": "button-eye-reader",
      "assets": {
        "directory": "./dist",
        "not_found_handling": "single-page-application",
      },
    },
    "test": {
      "name": "button-eye-reader-test",
      "assets": {
        "directory": "./dist",
        "not_found_handling": "single-page-application",
      },
    },
  },
}
