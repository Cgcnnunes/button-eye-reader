{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": "./src/worker.ts",
  "name": "button-eye-reader",
  "compatibility_date": "2026-11-07",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/", "/index.html", "/api", "/api/*", "/app", "/app/*"],
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "button-eye-reader-local",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations",
    },
  ],
  "observability": {
    "enabled": false,
  },
  "env": {
    "production": {
      "name": "button-eye-reader-prod",
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "button-eye-reader-prod",
          "database_id": "dd402c40-c51b-48a0-8e7d-48a7f08e8d04",
          "migrations_dir": "migrations",
        },
      ],
      "assets": {
        "binding": "ASSETS",
        "directory": "./dist",
        "not_found_handling": "single-page-application",
        "run_worker_first": ["/", "/index.html", "/api", "/api/*", "/app", "/app/*"],
      },
    },
    "test": {
      "name": "button-eye-reader-test",
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "button-eye-reader-test",
          "database_id": "612d2c7f-40fd-4922-a137-ce6c9aa7610f",
          "migrations_dir": "migrations",
        },
      ],
      "assets": {
        "binding": "ASSETS",
        "directory": "./dist",
        "not_found_handling": "single-page-application",
        "run_worker_first": ["/", "/index.html", "/api", "/api/*", "/app", "/app/*"],
      },
    },
  },
}
