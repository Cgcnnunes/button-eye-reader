{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": "./src/worker.ts",
  "name": "button-eye-reader",
  "compatibility_date": "2026-11-07",
  "workers_dev": true,
  "preview_urls": false,
  "vars": {
    "ACCESS_TEAM_DOMAIN": "REPLACE_WITH_TEAM.cloudflareaccess.com",
    "ACCESS_AUD": "REPLACE_WITH_LOCAL_ACCESS_AUD",
  },
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": true,
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "button-eye-reader-local",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations",
    },
  ],
  "observability": {
    "enabled": true,
    "redact_query_string": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": false,
      "persist": true,
    },
    "traces": {
      "enabled": false,
    },
  },
  "env": {
    "production": {
      "name": "button-eye-reader-prod",
      "vars": {
        "ACCESS_TEAM_DOMAIN": "rent-hub-pages.cloudflareaccess.com",
        "ACCESS_AUD": "67e88f139f35c1f9df4adff34f4cd817e6d91b32b915a07123c4fff4a812ba35",
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "button-eye-reader-prod",
          "database_id": "dd402c40-c51b-48a0-8e7d-48a7f08e8d04",
          "migrations_dir": "migrations",
        },
      ],
      "assets": {
        "binding": "ASSETS",
        "directory": "./dist",
        "not_found_handling": "single-page-application",
        "run_worker_first": true,
      },
    },
    "test": {
      "name": "button-eye-reader-test",
      "vars": {
        "ACCESS_TEAM_DOMAIN": "rent-hub-pages.cloudflareaccess.com",
        "ACCESS_AUD": "6751d8360526413107df37b27725eab3f784272ebdd82e88439c86a2cbb79702",
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "button-eye-reader-test",
          "database_id": "612d2c7f-40fd-4922-a137-ce6c9aa7610f",
          "migrations_dir": "migrations",
        },
      ],
      "assets": {
        "binding": "ASSETS",
        "directory": "./dist",
        "not_found_handling": "single-page-application",
        "run_worker_first": true,
      },
    },
  },
}
