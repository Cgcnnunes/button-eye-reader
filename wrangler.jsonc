{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": "./src/worker.ts",
  "name": "button-eye-reader",
  "compatibility_date": "2026-11-07",
  "workers_dev": true,
  "preview_urls": false,
  "vars": {
    "DEPLOYMENT_ENVIRONMENT": "development",
  },
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/", "/index.html", "/diagnostics", "/diagnostics/*", "/diagnostics.html"],
  },
  "observability": { "enabled": false },
  "triggers": { "crons": ["17 * * * *"] },
  "env": {
    "production": {
      "name": "button-eye-reader-prod",
      "triggers": { "crons": ["17 * * * *"] },
      "r2_buckets": [{ "binding": "REPORTS", "bucket_name": "button-eye-reader-reports-prod" }],
      "vars": {
        "DEPLOYMENT_ENVIRONMENT": "production",
      },
      "assets": {
        "binding": "ASSETS",
        "directory": "./dist",
        "not_found_handling": "single-page-application",
        "run_worker_first": [
          "/",
          "/index.html",
          "/diagnostics",
          "/diagnostics/*",
          "/diagnostics.html",
        ],
      },
    },
    "test": {
      "name": "button-eye-reader-test",
      "triggers": { "crons": ["17 * * * *"] },
      "r2_buckets": [{ "binding": "REPORTS", "bucket_name": "button-eye-reader-reports-test" }],
      "vars": {
        "DEPLOYMENT_ENVIRONMENT": "test",
      },
      "assets": {
        "binding": "ASSETS",
        "directory": "./dist",
        "not_found_handling": "single-page-application",
        "run_worker_first": [
          "/",
          "/index.html",
          "/diagnostics",
          "/diagnostics/*",
          "/diagnostics.html",
        ],
      },
    },
  },
}
