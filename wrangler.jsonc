{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": "./src/worker.ts",
  "name": "button-eye-reader",
  "compatibility_date": "2026-11-07",
  "workers_dev": true,
  "preview_urls": false,
  "vars": {
    "DEPLOYMENT_ENVIRONMENT": "development",
  },
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/", "/index.html"],
  },
  "observability": { "enabled": false },
  "env": {
    "production": {
      "name": "button-eye-reader-prod",
      "vars": {
        "DEPLOYMENT_ENVIRONMENT": "production",
      },
      "assets": {
        "binding": "ASSETS",
        "directory": "./dist",
        "not_found_handling": "single-page-application",
        "run_worker_first": ["/", "/index.html"],
      },
    },
    "test": {
      "name": "button-eye-reader-test",
      "vars": {
        "DEPLOYMENT_ENVIRONMENT": "test",
      },
      "assets": {
        "binding": "ASSETS",
        "directory": "./dist",
        "not_found_handling": "single-page-application",
        "run_worker_first": ["/", "/index.html"],
      },
    },
  },
}
